08000e5c <applyLowPassFilterVelocity2>:
float applyLowPassFilterVelocity(float X, float Y_old) {
    // Apply the first-order low-pass filter formula
    float Y = Y_old + G *dt_s* (X - Y_old);  // Filtered value
    return Y;
}
