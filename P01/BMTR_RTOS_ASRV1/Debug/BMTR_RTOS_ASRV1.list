08000eb0 <ConfigureMotor01>:
float applyLowPassFilterAcceleration(float X, float Y_old) {
    float alpha = 0.05f;  // Adjust as needed (lower = smoother, higher = faster response)
    return Y_old + alpha * (X - Y_old);
}
